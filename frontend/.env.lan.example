# apps/frontend/.env.lan.example
# LAN template for frontend build/runtime values. Placeholder values only.

# Frontend app runtime/build input.
# This is the primary variable consumed by frontend code at build/runtime.
VITE_API_BASE_URL=http://192.168.1.10:8000

# Operator and UE2E helper URLs.
# These are consumed by helper scripts/tests, not by frontend API client runtime.
FRONTEND_BASE_URL=http://192.168.1.10:5173
API_BASE_URL=http://192.168.1.10:8000

# Playwright and UE2E placeholders
UE2E_RUN_INTEGRATION=0
UE2E_AUTH_MODE=bearer
UE2E_OWNER_PERSONA=studentA
