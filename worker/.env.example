# apps/worker/.env.example
# Placeholder values only. Do not place real secrets in this file.

# Runtime environment
APP_ENV=development
EXAM_SYS_NEXT_DB_HEALTH_INTEGRATION=0

# Runtime DB role (application role only)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=exam_sys_dev
POSTGRES_USER=exam_sys_app
POSTGRES_PASSWORD=<runtime-db-password>
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=3

# Maintenance role (setup/migration/smoke/cleanup only)
POSTGRES_MAINTENANCE_HOST=127.0.0.1
POSTGRES_MAINTENANCE_PORT=5432
POSTGRES_MAINTENANCE_DB=exam_sys_dev
POSTGRES_MAINTENANCE_USER=postgres
POSTGRES_MAINTENANCE_PASSWORD=<maintenance-db-password>
POSTGRES_MAINTENANCE_SSLMODE=prefer

# Worker runtime controls
WORKER_ID=
WORKER_ID_PREFIX=wro
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_IDLE_SLEEP_SECONDS=2
WORKER_BATCH_SIZE=1
WORKER_LEASE_SECONDS=120
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_SECONDS=2
WORKER_MAX_RETRY_BACKOFF_SECONDS=16
WORKER_LOG_LEVEL=INFO
WORKER_RUN_ONCE=0
WORKER_STOP_AFTER_IDLE_CYCLES=

# Dispatcher
DISPATCHER_SUBMISSION_ID=
DISPATCHER_SUBMISSION_IDS=
DISPATCHER_ACTOR_USER_ID=
DISPATCHER_WORKER_ID=

# Capture runtime and DSN guard
CAPTURE_WORKER_ID=
CAPTURE_WORKER_LEASE_SECONDS=120
CAPTURE_WORKER_MAX_JOBS_PER_RUN=1
CAPTURE_WORKER_MAX_DATASET_ROWS=100
STUDENT_CAPTURE_ADAPTER_MODE=TEST
STUDENT_CAPTURE_SOURCE_DSN=
STUDENT_CAPTURE_ALLOWED_SCHEMAS=
STUDENT_CAPTURE_ALLOWED_TABLES=
ALLOW_STUDENT_CAPTURE_APP_DB_DSN_FOR_TESTS=0

# Grading runtime and sandbox DSN guard
GRADING_WORKER_ID=
GRADING_WORKER_LEASE_SECONDS=120
GRADING_WORKER_POLL_INTERVAL=2
GRADING_WORKER_MAX_TASKS_PER_RUN=
GRADING_WORKER_MAX_COMPARISONS_PER_RUN=
GRADING_WORKER_MAX_SCORES_PER_RUN=
TEXTBOX_SQL_EXECUTOR_DSN=
TEXTBOX_SQL_ALLOWED_SCHEMAS=
TEXTBOX_SQL_STATEMENT_TIMEOUT_MS=3000
TEXTBOX_SQL_MAX_ROWS=100
TEXTBOX_SQL_MAX_COLUMNS=50
ALLOW_TEXTBOX_SQL_APP_DB_DSN_FOR_TESTS=0

# Master data import worker
MD_IMPORT_WORKER_ID=
MD_IMPORT_WORKER_POLL_INTERVAL=2
MD_IMPORT_WORKER_LEASE_SECONDS=120
