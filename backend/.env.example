# apps/api/.env.example
# Placeholder values only. Do not place real secrets in this file.

# Runtime environment
EXAM_SYS_NEXT_ENV=development
APP_ENV=development

# API metadata and routing
EXAM_SYS_NEXT_API_TITLE=Exam Sys Next API
EXAM_SYS_NEXT_VERSION=0.1.0-dev
EXAM_SYS_NEXT_API_PREFIX=/api/v1
EXAM_SYS_NEXT_REQUEST_TIMEOUT=30
EXAM_SYS_NEXT_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Private exam paper asset storage (backend-only)
EXAM_SYS_PAPER_STORAGE_ROOT=var/private/exam_papers
EXAM_SYS_PAPER_ASSET_MAX_BYTES=26214400

# Runtime DB role (application role only)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=exam_sys_dev
POSTGRES_USER=exam_sys_app
POSTGRES_PASSWORD=<runtime-db-password>
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=3

# DB pool
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT=5
POSTGRES_POOL_MAX_IDLE=300

# Auth/JWT
EXAM_SYS_NEXT_ACCESS_TOKEN_SECRET=<strong-access-token-secret>
EXAM_SYS_NEXT_REFRESH_TOKEN_SECRET=<strong-refresh-token-secret>
EXAM_SYS_NEXT_TOKEN_ALGORITHM=HS256
EXAM_SYS_NEXT_ACCESS_TOKEN_EXPIRES_MINUTES=15
EXAM_SYS_NEXT_REFRESH_TOKEN_EXPIRES_MINUTES=10080

# Auth hardening controls
AUTH_RATE_LIMIT_ENABLED=true
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_SECONDS=900
AUTH_LOCKOUT_DURATION_SECONDS=900

# Optional extra secrets (if used)
EXAM_SYS_NEXT_SESSION_SECRET=<optional-session-secret>
EXAM_SYS_NEXT_COOKIE_SECRET=<optional-cookie-secret>
SESSION_SECRET=<optional-session-secret>
SESSION_SECRET_KEY=<optional-session-secret-key>
EXAM_SYS_NEXT_SIGNING_SECRET=<optional-signing-secret>
EXAM_SYS_NEXT_ENCRYPTION_SECRET=<optional-encryption-secret>
EXAM_SYS_NEXT_ENCRYPTION_KEY=<optional-encryption-key>
